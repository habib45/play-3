# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()


# Category CRUD
GET     /categories                 controllers.CategoryController.index(request: play.mvc.Http.Request)
POST    /categories                 controllers.CategoryController.save(request: play.mvc.Http.Request)
GET     /categories/create          controllers.CategoryController.createCategory(request: play.mvc.Http.Request)
GET     /categories/:id/edit        controllers.CategoryController.edit(request: play.mvc.Http.Request, id: Long)
POST    /categories/:id/update      controllers.CategoryController.update(request: play.mvc.Http.Request, id: Long)
GET     /categories/:id/delete      controllers.CategoryController.delete(request: play.mvc.Http.Request, id: Long)


# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
